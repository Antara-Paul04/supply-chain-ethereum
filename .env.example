# CoffeeChain Hardhat Environment Variables
# Copy this file to .env and fill in your values (optional)

# =============================================================================
# DEPLOYMENT CONFIGURATION (OPTIONAL)
# =============================================================================

# Private key for contract deployment
# WARNING: Never commit your actual private key to git!
# Use hardhat keystore instead: npx hardhat keystore set SEPOLIA_PRIVATE_KEY
# Only use .env for development/testing with test accounts
# Example: SEPOLIA_PRIVATE_KEY=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
# SEPOLIA_PRIVATE_KEY=

# RPC URL for Sepolia testnet (optional - uses public RPC by default)
# Get a free RPC URL from: https://www.alchemy.com/ or https://infura.io/
# Example: SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
# SEPOLIA_RPC_URL=

# Private key for Hoodi testnet deployment (if using Hoodi)
# HOODI_PRIVATE_KEY=

# RPC URL for Hoodi testnet (if needed)
# HOODI_RPC_URL=

# =============================================================================
# ETHERSCAN CONFIGURATION (OPTIONAL)
# =============================================================================

# Etherscan API key for contract verification
# Get your API key from: https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# RECOMMENDED METHOD (More Secure):
# Use Hardhat Keystore to store private keys securely:
#
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   (Enter your private key when prompted)
#
# This encrypts your key and stores it locally, never in plain text.

# ALTERNATIVE METHOD (For Testing Only):
# 1. Copy this file: cp .env.example .env
# 2. Add your private key to .env
# 3. Never commit .env to git (it's in .gitignore)

# =============================================================================
# DEPLOYMENT GUIDE
# =============================================================================

# Local Deployment (for testing):
#   npx hardhat node
#   (In another terminal)
#   npx hardhat ignition deploy ignition/modules/CoffeeBatch.ts --network localhost
#
# Testnet Deployment:
#   # First, set your private key
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#
#   # Deploy to Sepolia
#   npx hardhat ignition deploy ignition/modules/CoffeeBatch.ts --network sepolia
#
#   # Or deploy to Hoodi
#   npx hardhat keystore set HOODI_PRIVATE_KEY
#   npx hardhat ignition deploy ignition/modules/CoffeeBatch.ts --network hoodi
#
# After deployment:
#   - Copy the contract address
#   - Add it to frontend/.env.local as NEXT_PUBLIC_CONTRACT_ADDRESS
#   - Update frontend/src/utils/contract.ts if needed

# =============================================================================
# NOTES
# =============================================================================

# - Use test networks (Sepolia, Hoodi) for development
# - Never use real funds on testnets
# - Get testnet ETH from faucets:
#   - Sepolia: https://sepoliafaucet.com/
#   - Hoodi: Check Hoodi documentation for faucet
# - Keep private keys secret and never commit them
# - Use different keys for testnet vs mainnet
